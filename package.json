{
  "name": "@tubtimx/nexus-license-client",
  "version": "1.0.2",
  "description": "Shared license seat touch (activity renew) client for TubtimX Nexus External Apps → api-auth POST /sessions/heartbeat",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/numpea00/nexus-license-client.git"
  },
  "bugs": {
    "url": "https://github.com/numpea00/nexus-license-client/issues"
  },
  "homepage": "https://github.com/numpea00/nexus-license-client#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:esm": "tsc -p tsconfig.esm.json && node -e \"require('fs').copyFileSync('build-artifacts/esm-package.json','dist/esm/package.json')\"",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('fs').copyFileSync('build-artifacts/cjs-package.json','dist/cjs/package.json')\"",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:cjs",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit",
    "test": "pnpm run build && tsc -p tsconfig.test.json && node --test dist/cjs/touch-client.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
